*                               text=auto eol=lf

# Windows-only files keep CRLF
*.bat                           text eol=crlf
*.cmd                           text eol=crlf
*.ps1                           text eol=crlf

# Binaries: never touch
*.png                           binary
*.jpg                           binary
*.jpeg                          binary
*.gif                           binary
*.ico                           binary
*.svgz                          binary
*.pdf                           binary
*.zip                           binary
*.gz                            binary
*.woff                          binary
*.woff2                         binary
